{
  "name": "react-ts-latest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "prebuild:dev": "npm run sync:licenses",
    "build": "tsc && vite build --mode production",
    "prebuild": "npm run sync:licenses",
    "preview": "vite preview",
    "sync:licenses": "node -e \"const{cpSync}=require('fs');cpSync('../LICENSE','public/LICENSE');cpSync('../THIRD-PARTY-NOTICES.md','public/THIRD-PARTY-NOTICES.md')\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@plq/use-persisted-state": "^1.4.5",
    "@wailsio/runtime": "latest",
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.5"
  }
}
